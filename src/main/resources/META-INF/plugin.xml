<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.jpmand.idea.plugin.gitea</id>
    <name>Gitea</name>
    <vendor>JpMand</vendor>
    <version>0.0.1</version>
    <idea-version since-build="253"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.GiteaBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
                serviceImplementation="com.github.jpmand.idea.plugin.gitea.authentication.account.GitePersistentAccounts"/>
        <applicationService
                serviceInterface="com.github.jpmand.idea.plugin.gitea.authentication.account.GiteaAccountManager"
                serviceImplementation="com.github.jpmand.idea.plugin.gitea.authentication.account.PersistentGiteaAccountManager"/>
        <applicationService serviceInterface="com.github.jpmand.idea.plugin.gitea.api.GiteaApiManager"
                            serviceImplementation="com.github.jpmand.idea.plugin.gitea.api.GiteaApiManagerImpl"/>
        <projectService serviceInterface="com.github.jpmand.idea.plugin.gitea.GiteaRepositoriesManager"
                        serviceImplementation="com.github.jpmand.idea.plugin.gitea.GiteaRepositoriesManagerImpl"/>
        <applicationService serviceInterface="com.github.jpmand.idea.plugin.gitea.GiteaServersManager"
                            serviceImplementation="com.github.jpmand.idea.plugin.gitea.CachingGiteaServersManager"/>
        <diff.DiffExtension implementation="com.github.jpmand.idea.plugin.gitea.pullrequest.diff.GiteaPRDiffExtension"/>
        <fileEditorProvider implementation="com.github.jpmand.idea.plugin.gitea.pullrequest.GiteaPRTimelineEditorProvider"/>
        <toolWindow id="Gitea Pull Requests"
                    anchor="left"
                    secondary="true"
                    canCloseContents="true"
                    factoryClass="com.github.jpmand.idea.plugin.gitea.pullrequest.ui.toolwindow.GiteaPRToolWindowFactory"
                    icon="/images/giteaLogo.svg"/>
        <!--suppress PluginXmlI18n Name Gitea should not be translated-->
        <projectConfigurable parentId="project.propVCSSupport.Mappings" groupWeight="-600"
                             instance="com.github.jpmand.idea.plugin.gitea.ui.GiteaSettingsConfigurable"
                             displayName="Gitea"/>
        <vcsAnnotationGutterActionProvider
                implementation="com.github.jpmand.idea.plugin.gitea.extensions.GiteaAnnotationGutterActionProvider"/>

        <openapi.vcs.ui.cloneDialog.VcsCloneDialogExtension
            id="com.github.jpmand.idea.plugin.gitea.ui.clone.GiteaCloneDialogExtension"
            implementation="com.github.jpmand.idea.plugin.gitea.ui.clone.GiteaCloneDialogExtension"
            order="last"/>
    </extensions>
    <extensions defaultExtensionNs="Git4Idea">
        <GitHttpAuthDataProvider id="Gitea.Silent"
                                 implementation="com.github.jpmand.idea.plugin.gitea.authentication.extensions.GiteaSilentHttpAuthDataProvider"/>
        <GitHttpAuthDataProvider id="Gitea"
                                 implementation="com.github.jpmand.idea.plugin.gitea.authentication.extensions.GiteaHttpAuthDataProvider"/>
    </extensions>

    <actions>
        <!--suppress PluginXmlCapitalization -->
        <action id="Gitea.Open.Settings"
                class="com.github.jpmand.idea.plugin.gitea.ui.action.GiteaOpenSettingsAction"
                icon="/images/giteaLogo.svg">
            <!--suppress PluginXmlCapitalization -->
            <override-text place="MainMenu"/>
            <!--suppress PluginXmlCapitalization -->
            <override-text place="popup@GoToAction"/>
            <synonym key="action.Gitea.Add.Account.synonym"/>
        </action>

        <group id="Gitea.PullRequest.ToolWindow"
               class="com.intellij.openapi.actionSystem.DefaultActionGroup">
        </group>
        <group id="Gitea.Open.In.Browser"
               class="com.github.jpmand.idea.plugin.gitea.ui.action.GiteaOpenInBrowserActionGroup">
            <override-text place="GoToAction"/>
            <override-text place="EditorTabPopup"/>
            <override-text place="ProjectViewPopup" use-text-of-place="EditorTabPopup"/>
            <override-text place="EditorPopup" use-text-of-place="EditorTabPopup"/>
            <override-text place="BookmarksPopup" use-text-of-place="EditorTabPopup"/>
            <add-to-group group-id="Git.Hosting.Open.In.Browser.Group"/>
        </group>
        <group id="Gitea.Copy.Link"
               class="com.github.jpmand.idea.plugin.gitea.ui.action.GiteaCopyLinkActionGroup">
            <override-text place="CopyReferencePopup"/>
            <add-to-group group-id="Git.Hosting.Copy.Link.Group"/>
        </group>
        <action id="Gitea.Clone"
                class="com.github.jpmand.idea.plugin.gitea.ui.clone.GiteaCloneAction"
                icon="com.github.jpmand.idea.plugin.gitea.GiteaIcons.Logo">
            <override-text place="MainMenu"/>
            <override-text place="popup@GoToAction"/>
        </action>
    </actions>
</idea-plugin>
